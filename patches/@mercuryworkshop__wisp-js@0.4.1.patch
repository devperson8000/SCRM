diff --git a/src/server/net.mjs b/src/server/net.mjs
index 426329ab0d75b6b424f4e8afdc746e606ab14e61..85d6956201b2146fbe189bdfa608ed37067cd961 100644
--- a/src/server/net.mjs
+++ b/src/server/net.mjs
@@ -133,15 +133,34 @@ export class NodeTCPSocket {
     await new Promise((resolve, reject) => {
       this.socket = new net.Socket();
       this.socket.setNoDelay(true);
+
+      // Without an explicit timeout, a destination that never completes the
+      // TCP handshake (firewalled/blackholed, not merely refused) leaves
+      // this promise pending indefinitely, bounded only by the OS's own
+      // connect timeout (often minutes) -- leaking a socket and a stream
+      // per stuck attempt. Abort and surface a clear error instead.
+      let connect_timer = null;
+      if (options.connect_timeout_ms > 0) {
+        connect_timer = setTimeout(() => {
+          logging.warn(`tcp connect to ${this.hostname}:${this.port} timed out after ${options.connect_timeout_ms}ms`);
+          if (this.socket) this.socket.destroy();
+          reject(new Error(`connect timeout after ${options.connect_timeout_ms}ms connecting to ${this.hostname}:${this.port}`));
+        }, options.connect_timeout_ms);
+      }
+
       this.socket.on("connect", () => {
         this.connected = true;
+        if (connect_timer) clearTimeout(connect_timer);
         resolve();
       });
       this.socket.on("data", (data) => {
         this.data_queue.put(data);
       });
-      this.socket.on("close", (error) => {
-        if (error && !this.connected) reject();
+      this.socket.on("close", (hadError) => {
+        if (connect_timer) clearTimeout(connect_timer);
+        if (hadError && !this.connected) {
+          reject(new Error(`connection to ${this.hostname}:${this.port} closed with an error before connecting`));
+        }
         else this.data_queue.close();
         this.socket = null;
       });
